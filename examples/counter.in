# touch: kind 0 sets hits[idx] = val
{"port": 5, "event": "touch", "args": [{"kind": 0, "idx": 2, "val": 42}]}
# kind 1 bumps c.counts[idx] twice
{"port": 5, "event": "touch", "args": [{"kind": 1, "idx": 3, "val": 0}]}
{"port": 5, "event": "touch", "args": [{"kind": 1, "idx": 3, "val": 0}]}
{"get": "hits"}
{"get": "c_counts"}
# injected events: static args by name select the instance
{"port": 7, "event": "getAsync", "args": ["hits", 2]}
{"port": 7, "event": "getAsync", "args": ["c_counts", 3]}
# set a cell directly, then read it back through a self-generated async get (recirc port)
{"set": "hits", "index": 0, "value": 9}
{"port": 5, "event": "touch", "args": [{"kind": 2, "idx": 0, "val": 0}]}
